{
 "datasets": [
  {
   "name": "ds_daily",
   "displayName": "ds_daily",
   "queryLines": [
    "SELECT event_date, dataset, rows_in, rows_clean AS rows_passed, rows_dropped, rows_quarantined FROM dq_daily WHERE rule_name = '__all__' ORDER BY event_date"
   ],
   "columns": [
    {
     "displayName": "Passed share",
     "expression": "SUM(`rows_passed`) / SUM(`rows_in`)"
    },
    {
     "displayName": "Dropped share",
     "expression": "SUM(`rows_dropped`) / SUM(`rows_in`)"
    },
    {
     "displayName": "Quarantined share",
     "expression": "SUM(`rows_quarantined`) / SUM(CASE WHEN `dataset` IN ('calls', 'quality_scores') THEN `rows_in` END)"
    }
   ]
  },
  {
   "name": "ds_daily_stages",
   "displayName": "ds_daily_stages",
   "queryLines": [
    "SELECT event_date, dataset, stage, rows FROM (SELECT event_date, dataset, stack(2, 'passed', rows_clean, 'dropped', rows_dropped) AS (stage, rows) FROM dq_daily WHERE rule_name = '__all__') ORDER BY event_date"
   ]
  },
  {
   "name": "ds_rule_failures",
   "displayName": "ds_rule_failures",
   "queryLines": [
    "SELECT event_date, dataset, rule_name, action, rows_failed AS failures FROM dq_daily WHERE rule_name <> '__all__' UNION ALL SELECT to_date(event_ts) AS event_date, CASE WHEN table_name LIKE 'calls%' THEN 'calls' WHEN table_name LIKE 'transcripts%' THEN 'transcripts' WHEN table_name LIKE 'quality_scores%' THEN 'quality_scores' ELSE table_name END AS dataset, concat(expectation, ' (failed updates)') AS rule_name, 'fail' AS action, 1 AS failures FROM dq_pipeline_failures WHERE expectation IS NOT NULL"
   ]
  },
  {
   "name": "ds_rate_hourly",
   "displayName": "ds_rate_hourly",
   "queryLines": [
    "WITH m AS (SELECT date_trunc('HOUR', event_ts) AS hour, CASE WHEN dataset LIKE 'calls%' THEN 'calls' WHEN dataset LIKE 'transcripts%' THEN 'transcripts' WHEN dataset LIKE 'quality_scores%' THEN 'quality_scores' ELSE dataset END AS dataset, concat(dataset, '.', expectation) AS rule, sum(failed_records) AS failed, sum(passed_records + failed_records) AS total FROM dq_expectation_metrics WHERE dataset NOT IN ('daily_call_checks') GROUP BY ALL), top AS (SELECT rule FROM m GROUP BY rule ORDER BY sum(failed) DESC LIMIT 8) SELECT hour, to_date(hour) AS event_date, dataset, rule, failed, total, failed / nullif(total, 0) AS failure_rate FROM m WHERE rule IN (SELECT rule FROM top) AND total > 0 ORDER BY hour"
   ]
  },
  {
   "name": "ds_quarantine",
   "displayName": "ds_quarantine",
   "queryLines": [
    "WITH q AS (SELECT _loaded_at, 'calls' AS dataset, call_id, failed_rules, concat('agent=', coalesce(agent_id,'null'), ' queue=', coalesce(queue,'null'), ' duration_s=', coalesce(cast(duration_seconds AS STRING),'null'), ' start=', coalesce(cast(call_start_ts AS STRING),'null'), ' end=', coalesce(cast(call_end_ts AS STRING),'null')) AS key_columns, _source_file FROM calls_quarantine UNION ALL SELECT _loaded_at, 'quality_scores', call_id, failed_rules, concat('empathy=', coalesce(cast(empathy_score AS STRING),'null'), ' resolution=', coalesce(cast(resolution_score AS STRING),'null'), ' compliance=', coalesce(cast(compliance_score AS STRING),'null'), ' output=', left(coalesce(raw_model_output,'null'), 60)) AS key_columns, _source_file FROM quality_scores_quarantine) SELECT _loaded_at, to_date(_loaded_at) AS event_date, dataset, call_id, explode(failed_rules) AS rule_name, key_columns, element_at(split(_source_file, '/'), -1) AS source_file FROM q ORDER BY _loaded_at DESC LIMIT 2000"
   ]
  },
  {
   "name": "ds_failures",
   "displayName": "ds_failures",
   "queryLines": [
    "SELECT event_ts, to_date(event_ts) AS event_date, CASE WHEN table_name LIKE 'calls%' THEN 'calls' WHEN table_name LIKE 'transcripts%' THEN 'transcripts' WHEN table_name LIKE 'quality_scores%' THEN 'quality_scores' ELSE table_name END AS dataset, pipeline, coalesce(expectation, 'stream error') AS expectation, table_name, coalesce(example_record, left(error_message, 200)) AS example_record FROM dq_pipeline_failures ORDER BY event_ts DESC"
   ]
  }
 ],
